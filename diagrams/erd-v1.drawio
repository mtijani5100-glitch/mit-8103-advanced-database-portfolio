        <mxCell id="title" value="&lt;b&gt;LEDGERSPRING DIGITAL BANK (LSDB) — INITIAL ERD (v1)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;MIT 8103 Advanced Database Systems | Fictional Nigerian digital bank | Synthetic academic data&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontColor=#10213A;" vertex="1" parent="1">
          <mxGeometry x="210" y="10" width="1140" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="notes" value="&lt;b&gt;MODELLING NOTES &amp;amp; CONSTRAINTS&lt;/b&gt;&lt;br&gt;PK = primary key; FK = foreign key; UQ = unique.&lt;br&gt;CUSTOMER accounts have an owner; SETTLEMENT/SUSPENSE accounts may not. Deposits/withdrawals balance through system ledger accounts.&lt;br&gt;Posted transactions require balanced ledger entries. Reversals add compensating records; never erase history.&lt;br&gt;Reconcile cached balances against the ledger. All records in this academic model use synthetic data." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;strokeColor=#CBD5E1;fillColor=#F8FAFC;fontSize=12;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="1030" y="975" width="460" height="175" as="geometry"/>
        </mxCell>
        <mxCell id="legend" value="&lt;b&gt;RELATIONSHIP SUMMARY&lt;/b&gt;&lt;br&gt;Solid connector = required FK relationship; dashed = optional relationship.&lt;br&gt;CUSTOMERS 1 → 0..* CUSTOMER ACCOUNTS&lt;br&gt;CUSTOMER ACCOUNTS 1 → 0..* source/destination transactions&lt;br&gt;TRANSACTIONS 1 → 0..* LEDGER_ENTRIES&lt;br&gt;ACCOUNTS 1 → 0..* LEDGER_ENTRIES&lt;br&gt;Unique idempotency keys prevent duplicate request effects.&lt;br&gt;All records in this academic model use synthetic data." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;strokeColor=#CBD5E1;fillColor=#FFFFFF;fontSize=12;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="50" y="950" width="880" height="200" as="geometry"/>
